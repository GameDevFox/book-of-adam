data/texts/sources/**/raw/

# CMUdict download for the Deseret converter (regenerable via scripts/build-cmudict.mjs;
# the built public/deseret/cmudict.txt is the kept artifact)
data/deseret/sources/raw/

# quote-skill eval scratch
.claude/skills/quote-workspace/

# account-specific AWS identifiers and applied configs — kept per machine (docs/deploy.md)
deploy/aws/
