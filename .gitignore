node_modules/
dist/
.yarn/
tmp/

# texts library — personal copies of copyrighted editions (docs/design/texts-library.md)
data/texts/local/

# JoD scraper raw-HTML cache (parsed JSON is the kept artifact)
data/texts/sources/**/.cache/

# raw full-text downloads (regenerable; text lives in content/, metadata in
